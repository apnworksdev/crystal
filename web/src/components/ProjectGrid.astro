---
// @ts-nocheck
import Media from './Media.astro';

const { projects, emptyText = 'No projects yet.' } = Astro.props;
---

{
  projects.length > 0 ? (
    <ul class="project-grid">
      {projects.map((project, index) => (
        <li class="project-grid__item">
          <a class="project-card" href={`/projects/${project.slug}`}>
            <div class="project-card__media" transition:name={`project-${project.slug}-media`}>
              <Media
                media={project.thumbnail}
                sizes="(min-width: 800px) 50vw, 100vw"
                priority={index < 2}
              />
            </div>
            <div class="project-card__info">
              <h2 class="project-card__title" transition:name={`project-${project.slug}-title`}>
                {project.title}
              </h2>
              <span class="project-card__meta">
                {[project.brand, project.year].filter(Boolean).join(' · ')}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-message">{emptyText}</p>
  )
}
