---
import { stegaClean } from '@sanity/client/stega';
import '../styles/components/news.css';

// Opens beside the logo a few seconds after arrival (scripts/news.js). One item shows at a time.
// Pictures inside an item scroll; arrows change item. The first picture sets the window size.
// The same panel stays open beside About when About opens; it is not remounted.
const { items = [] } = Astro.props;
const titleId = 'news-title';
// Changing the items shows the panel again to people who closed the old ones.
const key = stegaClean(items.map((item) => item.title).join('|'));
const several = items.length > 1;
const first = items[0]?.images?.[0];
const firstRatio = first?.width && first?.height ? first.width / first.height : 3 / 4;
---

<section
  class="news-panel"
  data-news-panel
  data-news-key={key}
  data-news-index="0"
  style={`--news-ratio: ${firstRatio}`}
  hidden
  inert
  aria-labelledby={titleId}
>
  <div class="news-panel__head">
    <h2 class="news-panel__title" id={titleId}>News</h2>
    <button class="news-panel__close" type="button" data-news-close aria-label="Close news">
      <svg viewBox="0 0 21 24" aria-hidden="true"><path d="M5 6.5L16 17.5M16 6.5L5 17.5" stroke="currentColor" stroke-width="1" fill="none"></path></svg>
    </button>
  </div>
  <div class="news-panel__body">
    <div class="news-panel__bar">
      <div class="news-panel__titles" aria-live="polite">
        {
          items.map((item, index) => {
            const Tag = item.link ? 'a' : 'p';
            return (
              <Tag
                class="news-panel__item-title"
                data-news-item={index}
                href={item.link ? stegaClean(item.link) : undefined}
                hidden={index > 0}
              >
                {item.title}
              </Tag>
            );
          })
        }
      </div>
      {
        several && (
          <div class="news-panel__arrows">
            <button class="news-panel__arrow" type="button" data-news-step="-1" aria-label="Previous news">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18L8 12L15 6" stroke="currentColor" stroke-width="1" fill="none" /></svg>
            </button>
            <button class="news-panel__arrow" type="button" data-news-step="1" aria-label="Next news">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6L16 12L9 18" stroke="currentColor" stroke-width="1" fill="none" /></svg>
            </button>
          </div>
        )
      }
    </div>
    <div class="news-panel__images">
      {
        items.map((item, index) => {
          const lead = item.images[0];
          const ratio = lead?.width && lead?.height ? lead.width / lead.height : 3 / 4;
          return (
            <div
              class="news-panel__image"
              data-news-item={index}
              data-news-ratio={ratio}
              hidden={index > 0}
            >
              <div class="news-panel__photos" data-news-photos>
                {
                  item.images.map((picture, pictureIndex) => (
                    <img
                      src={picture.src}
                      srcset={picture.srcset}
                      sizes="(max-width: 48rem) 90vw, 36rem"
                      width={picture.width}
                      height={picture.height}
                      alt={picture.alt ?? ''}
                      loading={index === 0 && pictureIndex === 0 ? 'eager' : 'lazy'}
                    />
                  ))
                }
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
