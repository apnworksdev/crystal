---
import { stegaClean } from '@sanity/client/stega';
import '../styles/components/merch-reel.css';

const { products } = Astro.props;

const cards = products.map((product) => ({
  slug: stegaClean(product.slug),
  title: stegaClean(product.title) ?? '',
  image: product.images[0] ?? null,
  // How big it shows (Studio, 1 for a cap). Sizes the card in merch-reel.css.
  size: product.size ?? 1,
}));
// Known before the file arrives, so each picture holds its size and the reel does not shift.
const ratio = (image) => (image?.width > 0 && image?.height > 0 ? (image.width / image.height).toFixed(4) : undefined);
---

<h1 class="sr-only">Merch</h1>
{
  cards.length > 0 ? (
    <section
      class="merch-reel"
      data-merch-reel
      aria-label="Merch"
      style={`--reel-steps: ${Math.max(cards.length - 1, 0)}`}
    >
      <div class="merch-reel__stage">
        <div class="merch-reel__stack">
          {cards.map((card, index) => (
            <a
              class="merch-reel__card"
              href={`/merch/${card.slug}`}
              data-merch-card
              data-ratio={ratio(card.image) ? true : undefined}
              style={[`--size: ${card.size}`, ratio(card.image) ? `--ratio: ${ratio(card.image)}` : ''].filter(Boolean).join('; ')}
              tabindex={index === 0 ? 0 : -1}
            >
              {
                card.image && (
                  <img
                    src={card.image.src}
                    srcset={card.image.srcset}
                    sizes="(max-width: 48rem) 100vw, (min-width: 81.25rem) 52rem, 64vw"
                    width={card.image.width}
                    height={card.image.height}
                    alt=""
                  />
                )
              }
              <span class="sr-only" data-merch-title>{card.title}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="merch-reel__run" aria-hidden="true" />
    </section>
  ) : (
    <p class="empty-message">No products yet.</p>
  )
}
