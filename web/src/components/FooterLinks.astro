---
// The footer's contents: the contact line, the social links and the legal links. Used by the
// page footer (Base.astro) and, on phone, at the end of the About panel. `idPrefix` keeps
// the email field's id unique when both are on the page.
import { stegaClean } from '@sanity/client/stega';

const { email, links = [], idPrefix = 'footer' } = Astro.props;
const address = stegaClean(email ?? '');
const fieldId = `${idPrefix}-email`;
---

{/* Same order everywhere, as on the studio's preview: the contact line, the social links,
    then Privacy and Cookies together on one small line at the bottom. --i staggers the
    lines as the desktop footer opens (footer.css). */}
<p class="site-footer__label" style="--i: 0">Contact</p>
{
  address && (
    <form class="site-footer__form" action={`mailto:${address}`} style="--i: 1">
      <label class="sr-only" for={fieldId}>Email</label>
      <input id={fieldId} type="email" name="email" placeholder={address} autocomplete="email" />
      <button type="submit">Submit</button>
    </form>
  )
}
{
  links.map((link, index) => (
    <a class="site-footer__link" href={link.url} rel="me noopener" style={`--i: ${index + 2}`}>
      {link.label}
    </a>
  ))
}
<p class="site-footer__legal" style={`--i: ${links.length + 2}`}>
  <a class="site-footer__link" href="/privacy">Privacy Policy</a>
  <a class="site-footer__link" href="/cookies">Cookies Policy</a>
</p>
