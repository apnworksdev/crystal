---
import { stegaClean } from '@sanity/client/stega';
import { ClientRouter } from 'astro:transitions';
import AboutPanel from '../components/AboutPanel.astro';
import FooterLinks from '../components/FooterLinks.astro';
import Logo from '../components/icons/Logo.astro';
import NewsPanel from '../components/NewsPanel.astro';
import headerFlipSource from '../scripts/header-flip.js?raw';
import { getAbout, getSettings, isPreview } from '../lib/content.js';
import fontFaces from '../styles/common/fonts.css?raw';
import '../styles/common/variables.css';
import '../styles/common/globals.css';
import '../styles/common/main.css';
import '../styles/common/transitions.css';
import '../styles/components/header.css';
import '../styles/components/footer.css';
import '../styles/components/intro.css';
import '../styles/components/rotate-notice.css';

const { title, description, player = false, product = false } = Astro.props;
const headerFlipClassic = headerFlipSource.replace(
  /^export /m,
  '',
);
const [settings, about] = await Promise.all([getSettings(), getAbout()]);
const siteTitle = stegaClean(settings.title);
const pageTitle = title ? `${stegaClean(title)} · ${siteTitle}` : siteTitle;
const path = Astro.url.pathname;

const NAV = [
  ['Work', '/work'],
  ['Awards', '/awards'],
  ['Archive', '/archive'],
  ['Merch', '/merch'],
  ['About', null],
];
const isCurrent = (href) => path === href || path.startsWith(`${href}/`);
const onWork = path === '/work' || path === '/work/';
const onAwards = path === '/awards' || path === '/awards/';
const onArchive = path === '/archive' || path === '/archive/';
const usesMono = player || onWork || onArchive || onAwards;
const pageKind = player
  ? 'project'
  : product
    ? 'product'
    : onArchive
      ? 'archive'
      : onAwards
        ? 'awards'
        : undefined;
---

<!doctype html>
<html lang="en" class:list={[isPreview && 'is-preview']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={stegaClean(description ?? settings.description)} />
    {isPreview && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* The @font-face rules in their own block, the same on every page, so the page router
        keeps it across page changes. Bundled into each page's own styles, they were removed
        and added back on every change, and the menu's text blinked and shifted as the
        fonts were taken up again. */}
    <style is:inline set:html={fontFaces}></style>
    <link rel="preload" href="/fonts/MagisterST-Bold.woff2" as="font" type="font/woff2" crossorigin />
    {/* Medium is the Work stack's big titles (and the team, which loads it when About opens). */}
    {onWork && <link rel="preload" href="/fonts/MagisterST-Medium.woff2" as="font" type="font/woff2" crossorigin />}
    {/* Mono is only used by the player, credits, archive, awards and the work list. */}
    {usesMono && <link rel="preload" href="/fonts/MagisterMonoST-Regular.woff2" as="font" type="font/woff2" crossorigin />}
    {!settings.isPlaceholder && <link rel="preconnect" href="https://cdn.sanity.io" />}
    {/* Click-to-edit needs a stable page, so preview uses normal page loads. */}
    {!isPreview && <ClientRouter />}
    {/* Decides the intro before first paint. A module would run too late. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        /* Page transitions can run this again. Only a real page load decides. */
        if (root.dataset.introState || window.__introDecided) return;
        window.__introDecided = true;

        var reduce = false;
        try {
          reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}

        var replay = false;
        try {
          replay = new URLSearchParams(window.location.search).has('intro');
        } catch (e) {}
        /* Reloading the home page plays it again. */
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          if (nav && nav.type === 'reload' && window.location.pathname === '/') replay = true;
        } catch (e) {}

        var seen = false;
        try {
          seen = window.sessionStorage.getItem('intro-seen') === '1';
        } catch (e) {}

        var play = !reduce && (replay || !seen);
        try {
          window.sessionStorage.setItem('intro-seen', '1');
        } catch (e) {}

        root.dataset.introState = play ? 'play' : 'done';
        if (!play) return;

        root.classList.add('intro-play');
        root.setAttribute('aria-busy', 'true');

        function blockKeys(event) {
          event.preventDefault();
          event.stopPropagation();
        }
        document.addEventListener('keydown', blockKeys, true);
        document.addEventListener('keyup', blockKeys, true);

        var timer = window.setTimeout(function () {
          root.classList.remove('intro-play', 'intro-landed', 'intro-header', 'intro-page');
          release();
        }, 10000);

        function release() {
          window.clearTimeout(timer);
          document.removeEventListener('keydown', blockKeys, true);
          document.removeEventListener('keyup', blockKeys, true);
          root.removeAttribute('aria-busy');
          window.__introRelease = null;
        }

        window.__introRelease = release;
      })();
    </script>
  </head>
  <body data-page={pageKind}>
    {/* The red plate covers the page from first paint; intro.js draws the moving wordmark
        and the shrinking box into the canvas on top of it. */}
    <div class="intro" data-intro aria-hidden="true">
      <div class="intro__plate" data-intro-plate></div>
      <canvas class="intro__canvas" data-intro-canvas></canvas>
    </div>
    {/* A phone held sideways sees this instead of the page (rotate-notice.css). The site is
        laid out for a phone held upright; the project player still works sideways. */}
    <div class="rotate-notice" aria-hidden="true">
      <span class="rotate-notice__logo"><Logo /></span>
      <p class="rotate-notice__text">Turn your phone upright</p>
    </div>
    <header class="site-header" transition:persist="site-header" transition:animate="none">
      <a class="site-header__logo" href="/">
        <Logo />
        {/* The moving wordmark (logo-motion.js). The SVG above stays for pages without scripts. */}
        <canvas class="site-header__wordmark" data-wordmark aria-hidden="true"></canvas>
        <span class="sr-only">{settings.title}</span>
      </a>
      {settings.news && <NewsPanel items={settings.news} />}
      <div class="site-header__player" data-header-player>
        <div class="site-header__name" data-player-name>
          <div class="site-header__name-head">
            <h1 class="site-header__name-title">
              <button
                class="site-header__name-text"
                type="button"
                data-player-title
                hidden
                aria-expanded="false"
                aria-controls="project-info"
              ></button>
              <span class="site-header__name-text" data-player-label hidden></span>
            </h1>
            <button
              class="site-header__info-close"
              type="button"
              data-player-info-close
              hidden
              aria-label="Close details"
            >
              <svg viewBox="0 0 21 24" aria-hidden="true"><path d="M5 6.5L16 17.5M16 6.5L5 17.5" stroke="currentColor" stroke-width="1" fill="none"></path></svg>
            </button>
          </div>
          <div class="site-header__info" id="project-info" data-player-info hidden></div>
        </div>
        {/* The fluted glass over the video (project.js, fluted-glass.js), as on the mirror page. Off until clicked. */}
        <button class="site-header__slot" type="button" data-player-fx aria-pressed="false" aria-label="Fluted glass effect"><span class="site-header__slot-icon" aria-hidden="true">»«</span></button>
        <label class="site-header__seek">
          <span class="sr-only">Seek</span>
          <canvas class="site-header__wave" data-player-wave aria-hidden="true"></canvas>
          <input type="range" data-player-seek min="0" max="1000" value="0" step="1" />
        </label>
        <span class="site-header__time" data-player-time>00:00:00:00</span>
        <button class="site-header__close" type="button" data-player-close aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.7 6.7L17.3 17.3M17.3 6.7L6.7 17.3" stroke="currentColor" stroke-width="1" fill="none"></path></svg>
        </button>
      </div>
      <div class="site-header__context">
        <a class="site-header__project" data-header-project hidden></a>
      </div>
      <nav class="site-header__nav" id="site-nav" aria-label="Main">
        <div class="site-header__links">
          {NAV.map(([label, href]) => {
            const item = href ? (
              <a class="site-header__link" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            ) : (
              <button
                class="site-header__link"
                type="button"
                data-about-open
                aria-expanded="false"
                aria-controls="about-panel"
              >
                {label}
              </button>
            );
            if (href === '/work') {
              return (
                <div class="site-header__work">
                  {item}
                  <div class="site-header__views" data-work-views hidden={!onWork}>
                    <button class="site-header__view" type="button" data-view="list" aria-pressed="false">
                      List
                    </button>
                    <button class="site-header__view" type="button" data-view="reel" aria-pressed="true">
                      Stack
                    </button>
                  </div>
                </div>
              );
            }
            if (href === '/merch') {
              return (
                <div class="site-header__merch">
                  {item}
                  <h1 class="site-header__product-title" data-product-title hidden></h1>
                  <div class="site-header__product" data-product-buy hidden>
                    <span class="site-header__price" data-product-price></span>
                    <a class="site-header__buy" data-product-link href="#" target="_blank" rel="noopener">
                      Buy<span class="sr-only" data-product-buy-label></span>
                    </a>
                  </div>
                </div>
              );
            }
            return item;
          })}
        </div>
      </nav>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <span aria-hidden="true" data-header-mark>
          <svg data-header-plus viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5V19.5M4.5 12H19.5" stroke="currentColor" stroke-width="1" fill="none"></path></svg>
        </span>
      </button>
      <div class="site-header__columns" data-archive-columns>
        <span>Index</span>
        <span>Project Title</span>
        <span>Brand</span>
        <span>Year</span>
        <span>Time</span>
      </div>
      <AboutPanel about={about} email={settings.email} links={settings.links ?? []} news={settings.news ?? []} />
    </header>
    <script is:inline set:html={headerFlipClassic}></script>
    <script is:inline>
      /* Holds the header where it was, before paint, so a full page load can slide it. */
      (function () {
        try {
          if (location.pathname === '/work' || location.pathname === '/work/') {
            var listMode = sessionStorage.getItem('work-view') === 'list';
            if (listMode) document.body.dataset.workView = 'list';
            var viewButtons = document.querySelectorAll('[data-view]');
            for (var i = 0; i < viewButtons.length; i++) {
              viewButtons[i].setAttribute(
                'aria-pressed',
                viewButtons[i].getAttribute('data-view') === (listMode ? 'list' : 'reel') ? 'true' : 'false',
              );
            }
          }
          if (document.readyState === 'complete') return;
          /* Back from the mirror: white, with its logo in the middle, before first paint.
             mirror-trigger.js then shrinks the logo into the header (the way in, reversed). */
          var mirrorLogo = sessionStorage.getItem('crystal-mirror-leave');
          if (mirrorLogo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var veil = document.createElement('div');
            veil.className = 'mirror-enter';
            veil.setAttribute('data-mirror-return', 'cover');
            veil.setAttribute('aria-hidden', 'true');
            veil.style.cssText = 'position:fixed;inset:0;z-index:2147483646;background:var(--background-color)';
            var word = document.createElement('div');
            word.className = 'mirror-enter';
            word.setAttribute('data-mirror-return', 'logo');
            word.setAttribute('aria-hidden', 'true');
            word.innerHTML = mirrorLogo;
            var wordWidth = Math.min(innerWidth * 0.7, 1600);
            word.style.cssText =
              'position:fixed;z-index:2147483647;color:var(--foreground-color);' +
              'left:' + (innerWidth - wordWidth) / 2 + 'px;top:' + (innerHeight - wordWidth * 0.2) / 2 + 'px;' +
              'width:' + wordWidth + 'px;height:' + wordWidth * 0.2 + 'px';
            document.body.appendChild(veil);
            document.body.appendChild(word);
            /* The word inside the header logo waits hidden until this one has landed. */
            var headerWord = document.querySelectorAll('.site-header__logo > :not(.sr-only)');
            for (var w = 0; w < headerWord.length; w++) headerWord[w].style.visibility = 'hidden';
          }
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sessionStorage.removeItem('crystal-header-from');
            return;
          }
          var raw = sessionStorage.getItem('crystal-header-from');
          if (raw) {
            sessionStorage.removeItem('crystal-header-from');
            var from = JSON.parse(raw);
            var header = document.querySelector('.site-header');
            if (header && !header.dataset.flipTop) {
              var to = header.getBoundingClientRect();
              var flip = headerFlip(from, to, document.body.dataset.page === 'project');
              if (flip) {
                header.dataset.flipTop = String(from.top);
                header.dataset.flipLeft = String(from.left);
                header.dataset.flipWidth = String(from.width);
                header.dataset.flipToTop = String(to.top);
                header.dataset.flipToLeft = String(to.left);
                header.dataset.flipToWidth = String(to.width);
                header.style.transformOrigin = 'left center';
                header.style.transform = flip.start;
              }
            }
          }
          if (sessionStorage.getItem('crystal-cover-leave')) {
            var cover = document.createElement('div');
            cover.className = 'project-cover';
            cover.setAttribute('data-cover-hold', '');
            cover.setAttribute('aria-hidden', 'true');
            cover.style.top = '0';
            cover.style.left = '0';
            cover.style.width = '100vw';
            cover.style.height = '100vh';
            document.body.appendChild(cover);
          }
          /* Player stays hidden until is-arriving fades it in, so it does not flash open. */
          if (sessionStorage.getItem('crystal-cover-enter') && document.body.dataset.page === 'project') {
            var arriving = document.querySelector('.site-header');
            if (arriving) arriving.classList.add('is-arriving');
          }
        } catch (error) {
          /* Storage or layout can fail. The page still opens. */
        }
      })();
    </script>

    <div class="site-scroll" data-archive-scroll>
    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <FooterLinks email={settings.email} links={settings.links ?? []} />
    </footer>
    </div>

    <script>
      import '../scripts/page.js';
    </script>
  </body>
</html>
