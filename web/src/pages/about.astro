---
import Media from '../components/Media.astro';
import Base from '../layouts/Base.astro';
import { getAbout } from '../lib/content.js';
import { richTextToHtml } from '../lib/format.js';

const { content, team } = await getAbout();
const html = richTextToHtml(content);
---

<Base title="About">
  <h1 class="page-title">About</h1>
  {html && <div class="about__text rich-text" set:html={html} />}

  {
    team.length > 0 && (
      <section class="team" aria-labelledby="team-title">
        <h2 class="team__title" id="team-title">
          Team
        </h2>
        <ul class="team__list">
          {team.map((member) => (
            <li class="team-member">
              {member.image && (
                <div class="team-member__image">
                  <Media media={member.image} sizes="(min-width: 800px) 25vw, 50vw" />
                </div>
              )}
              <h3 class="team-member__name">{member.name}</h3>
              {member.position && <p class="team-member__position">{member.position}</p>}
              {member.description && <p class="team-member__description">{member.description}</p>}
              {member.favouriteTrack && (
                <p class="team-member__track">
                  <span class="team-member__track-label">Favourite track</span>{' '}
                  {member.favouriteTrack}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
