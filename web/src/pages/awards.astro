---
import Media from '../components/Media.astro';
import Base from '../layouts/Base.astro';
import { getAwards } from '../lib/content.js';
import '../styles/pages/awards.css';

const awards = await getAwards();
---

<Base title="Awards">
  <h1 class="sr-only">Awards</h1>
  {
    awards.length > 0 ? (
      <ul class="awards">
        {awards.map((award) => (
          <li class="award" tabindex="0">
            <p class="award__text">
              <span class="award__ceremony">{award.ceremony}</span>
              <span class="award__category">{award.category}</span>
              {award.work && <span class="award__work">{award.work}</span>}
            </p>
            {award.image && (
              <div class="award__image">
                <Media media={award.image} sizes="100vw" />
              </div>
            )}
            <span class="award__year">{award.year}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-message">No awards yet.</p>
    )
  }
</Base>
