---
import Base from '../layouts/Base.astro';
import { getArchiveProjects } from '../lib/content.js';
import '../styles/pages/archive.css';

const projects = await getArchiveProjects();
---

<Base title="Archive">
  <h1 class="sr-only">Archive</h1>
  {
    projects.length > 0 ? (
      <ol class="archive">
        {projects.map((project, index) => (
          <li class="archive__item">
            <span class="archive__index">{String(index + 1).padStart(3, '0')}</span>
            <span class="archive__title">{project.title}</span>
            <span class="archive__brand">{project.brand}</span>
            <span class="archive__year">{project.year}</span>
            <span class="archive__time">{project.time}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-message">No projects yet.</p>
    )
  }
</Base>
