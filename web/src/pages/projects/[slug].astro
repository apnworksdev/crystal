---
import { stegaClean } from '@sanity/client/stega';
import Base from '../../layouts/Base.astro';
import { getPageProjects } from '../../lib/content.js';
import { creditRows, richTextToHtml } from '../../lib/format.js';
import '../../styles/pages/project.css';

export async function getStaticPaths() {
  return (await getPageProjects()).map(({ slug }) => ({ params: { slug } }));
}

// Looked up by slug because preview mode renders on the server, without getStaticPaths.
const project = (await getPageProjects()).find(({ slug }) => slug === Astro.params.slug);
if (!project) return Astro.rewrite('/404');

const description = richTextToHtml(project.description);
// "Role: Name" lines, shown as two columns (lib/format.js).
const credits = creditRows(project.credits);
const hasInfo = Boolean(description || credits.length);
const media = project.mainMedia;
const kind = media?.kind === 'video' || media?.kind === 'image' ? media.kind : 'empty';
const poster = kind === 'image' ? media : media?.poster;
---

<Base title={project.title} player>
  <article
    class="project"
    data-project
    data-kind={kind}
    data-has-info={hasInfo ? '' : undefined}
  >
    <span class="project__source" data-project-title hidden>{project.title}</span>

    <div class="project__media" data-kind={kind}>
      {
        /* The player is mounted after the black cover. The poster only appears if autoplay is blocked. */
        kind === 'video' && poster && (
          <img
            class="project__poster"
            data-project-poster
            src={poster.src}
            srcset={poster.srcset}
            sizes="100vw"
            width={poster.width}
            height={poster.height}
            alt=""
            decoding="async"
            hidden
          />
        )
      }
      {
        kind === 'image' && poster && (
          <img
            class="project__poster"
            src={poster.src}
            srcset={poster.srcset}
            sizes="100vw"
            width={poster.width}
            height={poster.height}
            alt=""
            fetchpriority="high"
            decoding="async"
            style={poster.lqip ? `background: url(${poster.lqip}) center / cover` : undefined}
          />
        )
      }
      {
        kind === 'video' && media.source === 'file' && (
          <video
            class="project__frame"
            data-project-file
            data-src={media.src}
            crossorigin="anonymous"
            playsinline
            preload="none"
          />
        )
      }
      {
        kind === 'video' && media.source === 'vimeo' && (
          <iframe
            class="project__frame"
            data-project-vimeo
            data-src={media.frameSrc}
            title={stegaClean(project.title)}
            allow="autoplay; fullscreen; picture-in-picture"
            tabindex="-1"
          />
        )
      }
      <div class="project__hit" data-project-hit></div>
    </div>

    {
      hasInfo && (
        <div class="project__info-source" data-project-info hidden>
          {description && <div class="project__description rich-text" set:html={description} />}
          {credits.length > 0 && (
            <dl class="project__credits">
              {credits.map(({ label, value }) => (
                <div class="project__credit">
                  <dt class="project__credit-label">{label}</dt>
                  <dd class="project__credit-value">{value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      )
    }

    <div class="project__cursor" data-project-cursor hidden aria-hidden="true">
      {/* Outline only. project.js shows play while paused and pause while playing. Stroke 0.6 of
          the 12-unit box is 1px at the 20px drawn size; project.css scales it to half, so 0.5px. */}
      <svg data-icon="play" viewBox="0 0 12 12" aria-hidden="true">
        <path
          d="M2.5 1.3v9.4L10.3 6z"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
          stroke-linejoin="miter"
        ></path>
      </svg>
      <svg data-icon="pause" viewBox="0 0 12 12" hidden aria-hidden="true">
        <path
          d="M2.5 1.5h2v9h-2zm5 0h2v9h-2z"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
        ></path>
      </svg>
    </div>
  </article>
</Base>
