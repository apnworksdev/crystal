---
import ProjectGrid from '../components/ProjectGrid.astro';
import Base from '../layouts/Base.astro';
import { getHomeProjects } from '../lib/content.js';

const projects = await getHomeProjects();
---

<Base>
  <h1 class="visually-hidden">Selected work</h1>
  <ProjectGrid projects={projects} emptyText="Pick projects for the home page in the Studio." />
</Base>
