---
import Media from '../../components/Media.astro';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content.js';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map(({ slug }) => ({ params: { slug } }));
}

// Looked up by slug because preview mode renders on the server, without getStaticPaths.
const projects = await getProjects();
const index = projects.findIndex(({ slug }) => slug === Astro.params.slug);
if (index === -1) return Astro.rewrite('/404');

const project = projects[index];
const next = projects.length > 1 ? projects[(index + 1) % projects.length] : null;
const paragraphs = project.description?.split(/\n\s*\n/).filter(Boolean) ?? [];
---

<Base title={project.title} description={project.summary}>
  <article class="project">
    <header class="project-header">
      <h1 transition:name={`project-${project.slug}-title`}>{project.title}</h1>
      <p class="project-summary">{project.summary}</p>
      <dl class="project-meta">
        <div>
          <dt>Year</dt>
          <dd>{project.year}</dd>
        </div>
        {
          project.role && (
            <div>
              <dt>Role</dt>
              <dd>{project.role}</dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="project-media project-hero" transition:name={`project-${project.slug}-media`}>
      <Media image={project.hero} priority />
    </div>

    {paragraphs.length > 0 && <div class="prose">{paragraphs.map((text) => <p>{text}</p>)}</div>}

    {
      project.gallery.length > 0 && (
        <div class="gallery">
          {project.gallery.map((image) => (
            <Media image={image} />
          ))}
        </div>
      )
    }
  </article>

  {
    next && (
      <a class="next-project" href={`/work/${next.slug}`}>
        <span>Next project</span>
        <strong>{next.title}</strong>
      </a>
    )
  }
</Base>
