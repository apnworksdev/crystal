---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/content.js';

const settings = await getSettings();
const paragraphs = settings.bio?.split(/\n\s*\n/).filter(Boolean) ?? [];
---

<Base title="About">
  <h1 class="statement">About</h1>
  <div class="prose">{paragraphs.map((text) => <p>{text}</p>)}</div>
</Base>
